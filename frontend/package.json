{
  "name": "lexora-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:full-stack": "playwright test --config playwright.full-stack.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:public-demo": "playwright test --config playwright.public-demo.config.ts",
    "capture:release": "node scripts/capture-release-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "^3.5.0",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
