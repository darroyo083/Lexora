{
  "name": "lexora-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:full-stack": "playwright test --config playwright.full-stack.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:public-demo": "playwright test --config playwright.public-demo.config.ts",
    "capture:release": "node scripts/capture-release-assets.mjs",
    "render:home-hero": "remotion render remotion/index.tsx LexoraHomeHero public/release/lexora-home-hero.webm --codec=vp8 --width=1280 --height=720 --frames=0-299 --fps=30",
    "render:interactive-loop": "remotion render remotion/index.tsx LexoraInteractiveLoop public/release/lexora-interactive-loop.webm --codec=vp8 --width=1280 --height=720 --frames=0-269 --fps=30",
    "render:home-hero-poster": "remotion still remotion/index.tsx LexoraHomeHero public/release/lexora-home-hero-poster.png --frame=0 --image-format=png",
    "render:interactive-loop-poster": "remotion still remotion/index.tsx LexoraInteractiveLoop public/release/lexora-interactive-loop-poster.png --frame=0 --image-format=png",
    "render:product-loops": "npm run render:home-hero && npm run render:interactive-loop && npm run render:home-hero-poster && npm run render:interactive-loop-poster"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "^3.5.0",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@remotion/cli": "^4.0.512",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "^29.1.1",
    "remotion": "^4.0.512",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
