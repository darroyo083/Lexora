# Lexora local development defaults. Copy to .env; never commit real credentials.

# PostgreSQL
POSTGRES_DB=lexora
POSTGRES_USER=lexora
POSTGRES_PASSWORD=lexora_dev
POSTGRES_PORT=5432

# Local service ports
AI_SERVICE_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lexora
SPRING_DATASOURCE_USERNAME=lexora
SPRING_DATASOURCE_PASSWORD=lexora_dev
AI_SERVICE_BASE_URL=http://ai-service:8000
LEXORA_STORAGE_PATH=/app/storage
LEXORA_RASTER_DPI=300
LEXORA_PUBLIC_DEMO_ENABLED=false

# Local development uses local OCR by default. For the local/private AI
# runtime, select opencode-go and the smaller production image explicitly.
# The public production stack does not run ai-service at all.
LEXORA_ANALYSIS_PROVIDER=local-ocr
# LEXORA_AI_DOCKER_TARGET=production

# Optional local-only BookProfile association for private-workbook development:
# when a stored upload checksum matches LEXORA_BOOK_PROFILE_CHECKSUM, the book
# lazily attaches the profile row whose edition_key equals
# LEXORA_BOOK_PROFILE_EDITION_KEY. Public builds carry neither value, so no
# source-specific profile is ever attached.
# LEXORA_BOOK_PROFILE_CHECKSUM=
# LEXORA_BOOK_PROFILE_EDITION_KEY=

# Required only by the local/private OpenCode Go runtime.
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_MODEL=mimo-v2.5
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
# LEXORA_PROVIDER_TIMEOUT_SECONDS=90
# LEXORA_MAX_IMAGE_BYTES=10485760

# Production listener defaults remain loopback-only.
# LEXORA_BIND_ADDRESS=127.0.0.1
# LEXORA_HTTP_PORT=8088
