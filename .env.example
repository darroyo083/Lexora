# Lexora local development defaults. Copy to .env; never commit real credentials.

# PostgreSQL
POSTGRES_DB=lexora
POSTGRES_USER=lexora
POSTGRES_PASSWORD=lexora_dev
POSTGRES_PORT=5432

# Local service ports
AI_SERVICE_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lexora
SPRING_DATASOURCE_USERNAME=lexora
SPRING_DATASOURCE_PASSWORD=lexora_dev
AI_SERVICE_BASE_URL=http://ai-service:8000
LEXORA_STORAGE_PATH=/app/storage
LEXORA_RASTER_DPI=300
LEXORA_PUBLIC_DEMO_ENABLED=false
# Set only through compose.public-local.yml for loopback-only public-demo QA.
# Production rejects Cloudflare Turnstile test secrets.
LEXORA_PUBLIC_DEMO_LOCAL_QA=false

# Local development uses local OCR by default. For the local/private AI
# runtime, select opencode-go and the smaller production image explicitly.
# The public production stack runs ai-service internally for optional contextual
# assistance, with no published port; document analysis remains private/local.
LEXORA_ANALYSIS_PROVIDER=local-ocr
# LEXORA_AI_DOCKER_TARGET=production

# Optional local-only BookProfile association for private-workbook development:
# when a stored upload checksum matches LEXORA_BOOK_PROFILE_CHECKSUM, the book
# lazily attaches the profile row whose edition_key equals
# LEXORA_BOOK_PROFILE_EDITION_KEY. Public builds carry neither value, so no
# source-specific profile is ever attached.
# LEXORA_BOOK_PROFILE_CHECKSUM=
# LEXORA_BOOK_PROFILE_EDITION_KEY=

# Required only by the local/private OpenCode Go runtime.
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_MODEL=mimo-v2.5
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
# LEXORA_PROVIDER_TIMEOUT_SECONDS=90
# LEXORA_MAX_IMAGE_BYTES=10485760

# Production listener defaults remain loopback-only.
# LEXORA_BIND_ADDRESS=127.0.0.1
# LEXORA_HTTP_PORT=8088

# Optional Contextual AI Assistance ("Ask Lexora"). Disabled by default: opening
# the reader never triggers inference. Only an explicit learner action calls a
# provider. Provider credentials are server-side only and never reach the browser.
LEXORA_ASSIST_ENABLED=false
LEXORA_ASSIST_PROVIDER=openai-compatible
LEXORA_ASSIST_BASE_URL=
LEXORA_ASSIST_API_KEY=
LEXORA_ASSIST_MODEL=
LEXORA_ASSIST_TIMEOUT_SECONDS=30
LEXORA_ASSIST_MAX_OUTPUT_TOKENS=450
LEXORA_ASSIST_MAX_CONTEXT_CHARS=8000

# Abuse / cost controls (persistent server-side limits).
LEXORA_ASSIST_GLOBAL_DAILY_PROVIDER_LIMIT=100
LEXORA_ASSIST_SESSION_DAILY_LIMIT=10
LEXORA_ASSIST_HUMAN_VERIFICATION_TTL_MINUTES=30

# Cloudflare Turnstile (site key public, secret server-only). Use official test
# keys only for local/automated testing; production rejects test secrets.
# LEXORA_TURNSTILE_SITE_KEY=
# LEXORA_TURNSTILE_SECRET_KEY=

# Exact local public-demo QA command:
# docker compose -f docker-compose.yml -f compose.public-local.yml up --build
# Then open http://127.0.0.1:8088/demo. The override is loopback-only and uses
# official Cloudflare test credentials; it must never be used for production.
